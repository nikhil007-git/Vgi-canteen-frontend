# ==========================================
# VGI Canteen Frontend Environment Variables
# ==========================================

# Backend API Endpoint
# In local development: http://localhost:5000/api
# In local development: http://localhost:5001/api
# When deployed on Vercel: https://your-vgi-backend.vercel.app/api
VITE_API_URL=http://localhost:5000/api
VITE_API_URL=http://localhost:5001/api

# Realtime WebSocket Endpoint
# In local development: http://localhost:5000
# In local development: http://localhost:5001
# When deployed on Vercel: https://your-vgi-backend.vercel.app
VITE_SOCKET_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5001

# Razorpay Public Key ID (Test key or live key)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key

